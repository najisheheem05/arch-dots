# NVTOP Color Configuration Template
# Format: color_name = RGB_HEX_VALUE
# Colors must be specified as 6-digit hex values without # prefix

# Background colors
background = #141414
selected_bg = #202020
header_bg = #474747

# Text colors
text = #e2e2e2
selected_text = #c7c7c7
header_text = #c6c6c6
inactive_text = #919191

# GPU utilization colors (gradient from low to high)
gpu_util_low = #b5e9e9
gpu_util_med = #ecf3f0
gpu_util_high = #9db5e2

# Memory usage colors
memory_low = #c3e6e9
memory_med = #9fcfdb
memory_high = #8ec5d7

# Temperature colors (cool to hot)
temp_cool = #b5e9e9
temp_warm = #ecf3f0
temp_hot = #9db5e2

# Power usage colors
power_low = #b5e9e9
power_med = #bed4bc
power_high = #b7bed5

# Process list colors
process_normal = #e2e2e2
process_highlight = #c7c7c7
process_killed = #9db5e2

# Border and separator colors
border = #919191
separator = #474747

# Chart and graph colors
chart_line = #c8c6c5
chart_fill = #202020

# Status indicators
status_ok = #b5e9e9
status_warning = #ecf3f0
status_error = #9db5e2
status_info = #8ec5d7
